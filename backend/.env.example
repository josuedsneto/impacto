# Supabase project URL
SUPABASE_URL=https://your-project.supabase.co

# Service role key (Project Settings → API → service_role secret)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# RS256 public key for JWT validation — used by backend/auth.py for local JWT verification (no network call)
# Get from: https://<project-ref>.supabase.co/auth/v1/jwks then convert to PEM
# Paste the full PEM-formatted public key (with -----BEGIN PUBLIC KEY----- header)
SUPABASE_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000
