# Supabase project URL
SUPABASE_URL=https://your-project.supabase.co

# Service role key (Project Settings → API → service_role secret)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# RS256 public key for JWT validation (Project Settings → API → JWT Settings → JWT Secret)
# Paste the full PEM-formatted public key
SUPABASE_JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000
