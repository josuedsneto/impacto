# Supabase project URL
SUPABASE_URL=https://your-project.supabase.co

# Service role key (Project Settings → API → service_role secret)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ES256 (P-256) public key for JWT validation — used by backend/auth.py for local JWT verification (no network call)
# Supabase uses ES256, not RS256. Get the JWK JSON from:
#   https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# Copy the single key object (the value of keys[0]) as a JSON string
SUPABASE_JWT_JWK='{"alg":"ES256","crv":"P-256","kty":"EC","use":"sig","x":"...","y":"..."}'

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000
