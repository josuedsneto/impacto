# Supabase project URL (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon key (Project Settings → API → anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# FastAPI base URL (relative path when behind Nginx, or full URL for local dev)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Stripe publishable key (safe to expose to browser — used for future embedded elements)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
